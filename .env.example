# --- Producción (Netlify + Neon) ---
# URL de conexión del propietario de la base, tal como la da Neon. Solo se usa para las migraciones.
DATABASE_OWNER_URL=postgresql://neondb_owner:CONTRASEÑA@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Contraseña del rol value_app, con el que trabaja la aplicación (al menos 24 caracteres aleatorios).
APP_DB_PASSWORD=
# Código para la configuración inicial (/configuracion-inicial), al menos 16 caracteres.
SETUP_TOKEN=
# Entorno de la AEAT para VERI*FACTU: "pruebas" o "produccion"
VERIFACTU_ENTORNO=pruebas
# Productor del sistema informático de facturación (opcional; por defecto, la propia empresa)
SIF_PRODUCTOR_NIF=
SIF_PRODUCTOR_NOMBRE=

# --- Desarrollo local ---
# Con un rol que no sea superusuario. Si se define, tiene prioridad sobre las variables de arriba.
DATABASE_URL=postgres://value:value@localhost:5432/value
